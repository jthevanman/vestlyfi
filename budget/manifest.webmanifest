{
  "id": "/budget/",
  "name": "VestlyFi Budget",
  "short_name": "Budget",
  "description": "Log spending and income in a tap.",
  "start_url": "/budget/?add=1",
  "scope": "/budget/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#0b0b0b",
  "theme_color": "#0b0b0b",
  "icons": [
    { "src": "/budget/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/budget/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/budget/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Add spending", "short_name": "Spent", "url": "/budget/?add=spent", "icons": [{ "src": "/budget/icon-192.png", "sizes": "192x192" }] },
    { "name": "Add income", "short_name": "Received", "url": "/budget/?add=received", "icons": [{ "src": "/budget/icon-192.png", "sizes": "192x192" }] }
  ]
}
